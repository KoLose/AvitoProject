#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android — критически важно!
android/local.properties      # пути к SDK, не должен попадать в репозиторий
android/key.properties        # ключи подписи приложения (если используете)

# iOS
ios/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/

# Секреты
.env
.env.*
!.env.example                 # пример конфигурации можно оставить

# Кодогенерация (freezed, json_serializable и др.)
*.freezed.dart
*.g.dart
*.mocks.dart